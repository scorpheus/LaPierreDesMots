# La Pierre des Mots — ce qui ne part JAMAIS sur git.
# Liste prescrite par le contrat technique v1 § 1.1, complétée en fin de fichier.

# --- dépendances (décision D9 : tout est local, jamais d'installation globale)
node_modules/
.venv/
outils/

# --- artefacts de compilation
dist/
dist-test/
dist-autonome/
dist-pwa/
*.tsbuildinfo

# --- données de jeu (le dossier `donnees/` est suivi par son `.gitkeep`, pas son contenu)
donnees/*.db
donnees/*.db-wal
donnees/*.db-shm
donnees/*.db-journal
donnees/*.pid
# Les sauvegardes prises avant une remise à zéro : c'est la base VÉCUE de l'enfant, donc la
# même donnée de jeu, dans un sous-dossier. Les motifs ci-dessus ne descendaient pas d'un cran
# et 1,7 Mo de base réelle seraient partis au dépôt au premier `git add -A`.
donnees/sauvegardes/

# --- sorties de test (le `.gitkeep` de `tests/rapports/` reste suivi)
tests/rapports/
!tests/rapports/.gitkeep
playwright-report/
test-results/
coverage/

# --- contenu produit par agent, avant relecture parent
# Règle non négociable : rien n'atteint l'enfant sans validation humaine.
contenu/brouillons/*
!contenu/brouillons/.gitkeep

# --- audio : artefacts de build, régénérables depuis `production/voix.lock.json`
contenu/audio/

# --- environnement local (`.env.exemple` reste suivi, c'est le modèle)
.env
.env.local

# --- système et éditeurs
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# --- types generes par `tsc -b` (artefacts, jamais versionnes)
dist-types/

# --- bac a sable des agents : brouillons, scripts d inspection, HTML d essai
# (le LISEZ-MOI reste versionne, il porte la regle)
bac-a-sable/*
!bac-a-sable/LISEZ-MOI.md

# Polices de lecture — TÉLÉCHARGÉES, JAMAIS VERSIONNÉES (D9).
# `client/public/polices/LICENCES.md` le dit depuis toujours : « un dépôt de code n'est pas un
# miroir de distribution ». Mais rien ne l'appliquait — les binaires apparaissaient en
# non-suivis, prêts à être emportés par un `git add` large. Les empreintes SHA-256 sont épinglées
# dans `scripts/telecharger-polices.mjs`, qui refuse d'écrire un fichier divergent.
client/public/polices/*.woff2
client/public/polices/*.woff
client/public/polices/*.ttf

# Archives des habillages-bouchons remplacés par `scripts/dessiner-decors.mjs`. Ce sont des
# copies de sauvegarde du générateur, pas des sources.
production/archives/habillages-bouchons/
