# Contrat technique v1 § 0 : UTF-8 sans BOM, fins de ligne LF, 2 espaces.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# Les fichiers de commandes Windows exigent CRLF : `cmd.exe` interprète mal un `.bat` en LF
# dès qu'une ligne dépasse une simple commande (blocs `if (...)`, `for`, labels `goto`).
# Ils sont par ailleurs écrits en ASCII pur — les messages accentués vivent dans les `.mjs`,
# que Node affiche correctement quelle que soit la page de code de la console.
[*.{bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.{json,jsonc}]
indent_size = 2

[*.svg]
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
