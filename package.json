{
  "name": "pierre-des-mots",
  "version": "1.0.0",
  "private": true,
  "description": "La Pierre des Mots — application de lecture hors-ligne pour un enfant de CE1, servie en local sur le LAN.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "workspaces": [
    "partage",
    "serveur",
    "client"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "preparer": "node scripts/telecharger-outils.mjs",
    "preparer:navigateurs": "node scripts/playwright.mjs install chromium",
    "typescript": "tsc -b",
    "lint": "eslint .",
    "construire": "npm run construire -w @pierre/partage && npm run construire -w @pierre/serveur && npm run construire -w @pierre/client",
    "construire:test": "npm run construire:test -w @pierre/client",
    "ingerer": "node scripts/ingerer.mjs",
    "profil:reinitialiser": "node scripts/reinitialiser-profil.mjs",
    "voix:preparer": "node scripts/telecharger-tts.mjs",
    "voix": "node scripts/rendre-voix.mjs",
    "voix:qc": "node scripts/qc-voix.mjs",
    "voix:recenser": "node scripts/recenser-textes.mjs",
    "dev": "node scripts/demarrer.mjs --dev",
    "demarrer": "node scripts/demarrer.mjs",
    "test": "vitest run --project unitaires --project composants --project api",
    "test:contenu": "node scripts/test-contenu.mjs",
    "test:e2e": "node scripts/playwright.mjs test --project=parcours --project=robustesse",
    "test:visuel": "node scripts/test-visuel.mjs",
    "test:qualite": "node scripts/playwright.mjs test --project=qualite && node scripts/verifier-bundle.mjs",
    "test:rejeu": "node scripts/test-rejeu.mjs",
    "qa:mutations": "node scripts/qa/banc-de-mutation.mjs",
    "qa:trompeurs": "node scripts/qa/tests-trompeurs.mjs",
    "qa:tableau": "node scripts/qa/tableau-de-bord.mjs",
    "verifier": "node scripts/verifier.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.95.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "fastify": "^5.0.0",
    "motion": "^12.0.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tone": "^15.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "fast-check": "^4.0.0",
    "globals": "^16.0.0",
    "happy-dom": "^18.0.0",
    "lefthook": "^1.10.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
