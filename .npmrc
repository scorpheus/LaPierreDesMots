# Contrat technique v1 § 1.1.

# Refuse d'installer si la version de Node ne satisfait pas `engines` du package.json.
# Le socle repose sur `node:sqlite` intégré (Node 24) : mieux vaut un refus net à
# l'installation qu'une erreur incompréhensible au premier `import`.
engine-strict=true

# Silence utile : ces deux blocs de sortie noient le seul message qui compte, l'erreur.
fund=false
audit=false

# Décision D9 — le dépôt est auto-contenu. Rien ne s'installe hors du dossier du projet.
# `npm install -g` reste interdit par la règle, pas par ce fichier ; on le rappelle ici
# parce que c'est le premier endroit où on vient chercher la configuration npm.
save-exact=false
