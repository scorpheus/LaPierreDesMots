# La Pierre des Mots — modèle de configuration locale.
# Copier en `.env` à la racine et adapter. `.env` est ignoré par git, ce fichier ne l'est pas.
# Les 5 variables sont celles du contrat technique v1 § 1.1 ; toutes ont un défaut sain,
# aucune n'est obligatoire pour jouer.

# Port HTTP du serveur Fastify. Défaut : 8080.
# C'est ce port qui apparaît dans l'URL affichée par `demarrer.bat`.
PIERRE_PORT=8080

# Graine de l'aléatoire (`Alea`). Fixée = partie reproductible, indispensable au rejeu (T2).
# Laisser vide en jeu réel pour que chaque session tire sa propre graine.
ATELIER_GRAINE=20260801

# Chemin du fichier SQLite. Relatif = résolu depuis la racine du dépôt (décision D9 :
# la base vit dans le dépôt, jamais dans %APPDATA%).
# `:memory:` en test — c'est ce que passent les tests d'API.
PIERRE_BASE=donnees/pierre.db

# Racine des exercices, habillages, SVG et schémas servis par `DepotContenu`.
PIERRE_CONTENU=contenu

# Serveur LLM local, compatible OpenAI (décision D5 : llama.cpp, port 8001).
# Le serveur doit se comporter correctement quand il est ABSENT : rien de ce qui est
# nécessaire à l'enfant pour jouer ne doit en dépendre.
PIERRE_LLM_URL=http://127.0.0.1:8001
