# La Pierre des Mots — modèle de configuration locale.
# Copier en `.env` à la racine et adapter. `.env` est ignoré par git, ce fichier ne l'est pas.
# Les 5 variables du contrat technique v1 § 1.1 sont là ; toutes ont un défaut sain,
# aucune n'est obligatoire pour jouer.
#
# Deux variables SUPPLÉMENTAIRES sont documentées plus bas — `PIERRE_HOTE` et `PIERRE_CLIENT`.
# Elles ne figurent pas au § 1.1, mais `serveur/src/configuration.ts` les LIT réellement
# (`lireConfiguration`, variables lues : PIERRE_PORT, PIERRE_HOTE, PIERRE_BASE, PIERRE_CONTENU,
# PIERRE_CLIENT, ATELIER_GRAINE). Une variable lue par le code et absente du modèle est un
# piège : `PIERRE_CLIENT` est celle dont dépend TOUTE la suite E2E, et rien ne le disait.
# Écart au contrat gelé déclaré dans `Docs/ecarts-au-contrat-chaine-verifier.md`.

# Port HTTP du serveur Fastify. Défaut : 8080.
# C'est ce port qui apparaît dans l'URL affichée par `demarrer.bat`.
PIERRE_PORT=8080

# Interface d'écoute. Défaut : 0.0.0.0 — toutes les interfaces, parce que le jeu se joue
# depuis la tablette, sur le LAN. Mettre 127.0.0.1 pour n'écouter que la machine locale.
PIERRE_HOTE=0.0.0.0

# Graine de l'aléatoire (`Alea`). Fixée = partie reproductible, indispensable au rejeu (T2).
# Laisser vide en jeu réel pour que chaque session tire sa propre graine.
ATELIER_GRAINE=20260801

# Chemin du fichier SQLite. Relatif = résolu depuis la racine du dépôt (décision D9 :
# la base vit dans le dépôt, jamais dans %APPDATA%).
# `:memory:` en test — c'est ce que passent les tests d'API.
PIERRE_BASE=donnees/pierre.db

# Racine des exercices, habillages, SVG et schémas servis par `DepotContenu`.
PIERRE_CONTENU=contenu

# Dossier du client bâti servi en statique. Laisser VIDE en usage normal : le serveur choisit
# alors `client/dist` s'il existe, sinon `client/dist-test` (contrat § 7.3, les deux dossiers
# ne se croisent jamais).
# La suite E2E, elle, la force à `client/dist-test` — c'est la seule construction qui embarque
# `window.__test`. Cette valeur est posée par `playwright.config.ts`, pas par ce fichier :
# la laisser ici la ferait fuiter dans une partie réelle, où les crochets de test n'ont
# rien à faire.
PIERRE_CLIENT=

# Serveur LLM local, compatible OpenAI (décision D5 : llama.cpp, port 8001).
# Le serveur doit se comporter correctement quand il est ABSENT : rien de ce qui est
# nécessaire à l'enfant pour jouer ne doit en dépendre.
PIERRE_LLM_URL=http://127.0.0.1:8001

# ─────────────────────────────────────────────────────────────────────────────────────
# NE PAS régler ici : `PLAYWRIGHT_BROWSERS_PATH`.
#
# Les navigateurs de Playwright pèsent ~450 Mo et s'installeraient par défaut dans
# %LOCALAPPDATA%\ms-playwright, HORS du dépôt — ce qui viole la décision D9.
# Le dépôt les met dans `outils/navigateurs/` (ignoré par git). Cette valeur est posée par
# `scripts/playwright.mjs`, seul point d'entrée de Playwright, et par lui seul : la variable
# doit être en place AVANT le chargement de `playwright-core`, ce qu'un fichier `.env` lu
# après coup ne garantit pas.
#
# Pour installer le navigateur :   npm run preparer:navigateurs
# (jamais `npx playwright install` en direct — il écrirait hors du dépôt.)
